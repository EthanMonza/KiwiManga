# --- Required ---
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# You may use TELOXIDE_TOKEN instead of BOT_TOKEN (BOT_TOKEN wins if both set).

# --- Storage (Railway: attach a Volume mounted at /data!) ---
DATABASE_URL=sqlite:/data/bot.db?mode=rwc
DATA_DIR=/data

# --- Workers / limits ---
WORKERS=2
MAX_FILE_MB=50

# --- Logging ---
LOG_LEVEL=info

# --- Sources (comma-separated subset of: mangadex,ranobelib) ---
SOURCES_ENABLED=mangadex,ranobelib

# --- Default volume packing for new users: merged | per_chapter ---
VOLUME_PACK_DEFAULT=merged

# --- Source endpoints (override only for tests / mirrors) ---
MANGADEX_API_BASE=https://api.mangadex.org
RANOBELIB_API_BASE=https://api.cdnlibs.org/api

# --- HTTP behaviour ---
HTTP_TIMEOUT_SECS=30
HTTP_MAX_ATTEMPTS=5
